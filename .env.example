# =====================================================================
# Flawless Dance & Fitness Studio — Environment Variables Template
# =====================================================================
# When deploying to Vercel:
# 1. Go to Project Settings -> Environment Variables in your Vercel Dashboard.
# 2. Add the variable ADMIN_PASSWORD with your secure production password.
# 3. Add NEXT_PUBLIC_SITE_URL with your registered custom domain.
# =====================================================================

# Admin Operations Terminal Password (REQUIRED)
# Used to authenticate at https://flawlessdance.in/admin and authorize /api/admin/* endpoints
ADMIN_PASSWORD=fdfs@admin2026

# Canonical Domain URL (REQUIRED in production)
NEXT_PUBLIC_SITE_URL=https://flawlessdance.in
